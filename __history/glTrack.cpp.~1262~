// Verifică dacă imprimanta există
bool PrinterExists(const String &printerName)
{
    for (int i = 0; i < Printer()->Printers->Count; i++) {
        if (Printer()->Printers->Strings[i] == printerName)
            return true;
    }
    return false;
}

