    Label->Top = 30;
    Label->AutoSize = true;

    TButton* YesButton = new TButton(ConfirmDialog);
    YesButton->Parent = ConfirmDialog;
    YesButton->Caption = "Da";
    YesButton->ModalResult = mrYes;
    YesButton->Left = 50;
    YesButton->Top = 70;

